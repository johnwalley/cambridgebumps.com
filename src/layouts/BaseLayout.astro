---
import "@/styles/globals.css";

import { ClientRouter } from "astro:transitions";

import GoogleAnalytics from "@/components/GoogleAnalytics.astro";
import { SiteHeader } from "@/components/site-header";
import { googleAnalyticsTag, homeEvents, siteConfig } from "@/config/site";
import { summary } from "@/data/results";
import { set, yearOf } from "@/lib/utils";

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Path (or absolute URL) for <link rel="canonical">. Defaults to this page. */
  canonical?: string | null;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
}

// During the build `Astro.url.pathname` follows `build.format` — a trailing
// slash for "directory" (`/about/`, which `@astrojs/vercel` forces), `.html`
// for "file" — while the dev server and the deployed site both serve
// `/about`. Normalise it so canonical URLs and the header's idea of "where am
// I" are the URLs visitors actually see.
const pathname =
  Astro.url.pathname
    .replace(/\/?(index)?\.html$/, "")
    .replace(/(.)\/$/, "$1") || "/";

// The default description and the keywords name only the site's own events;
// the first year is the earliest any of them has results for.
const homeEventNames = homeEvents.map((event) => set[event]);
const firstYear = Math.min(
  ...homeEvents.flatMap((event) =>
    [...summary[event].men, ...summary[event].women].map(yearOf),
  ),
);
const defaultDescription = `Interactive charts and historical results for ${siteConfig.title} bumps rowing races. Explore ${new Intl.ListFormat("en-GB").format(homeEventNames)} from ${firstYear} to today.`;
const keywords = [
  "Bumps",
  "rowing",
  "charts",
  siteConfig.title,
  ...homeEventNames,
].join(", ");

const {
  title,
  description = defaultDescription,
  canonical = pathname,
  noindex = false,
  ogTitle,
  ogDescription,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
const canonicalUrl = canonical ? new URL(canonical, Astro.site) : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="format-detection"
      content="telephone=no, date=no, address=no, email=no"
    />
    <meta name="chrome" content="nointentdetection" />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="John Walley" />
    <link rel="author" href="https://www.walley.org.uk" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <slot name="head" />

    {/*
      Navigation swaps the page in place rather than loading a new document, so
      moving between years keeps the scroll position and drops the white flash
      between pages. Links are prefetched on hover (see `astro.config.mjs`), so
      the swap usually has nothing left to fetch.
    */}
    <ClientRouter />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={ogTitle ?? pageTitle} />
    <meta property="og:description" content={ogDescription ?? description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@johnmwalley" />

    {/* Applies the stored theme before first paint, so there's no flash. */}
    <script is:inline>
      (() => {
        const applyTheme = () => {
          try {
            const stored = localStorage.getItem("theme");
            const theme =
              stored === "light" || stored === "dark"
                ? stored
                : window.matchMedia("(prefers-color-scheme: dark)").matches
                  ? "dark"
                  : "light";

            document.documentElement.classList.toggle("dark", theme === "dark");
            document.documentElement.style.colorScheme = theme;
          } catch {
            // Ignore (private mode / storage disabled).
          }
        };

        applyTheme();

        // A view transition replaces <html>'s attributes with the incoming
        // page's, which drops the class just set. `astro:after-swap` runs
        // before the new page paints, so re-applying there keeps the theme
        // steady across navigation. This script isn't re-run on a swap, so the
        // listener is only ever registered once.
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-background focus:p-4 focus:text-foreground"
    >
      Skip to main content
    </a>
    <SiteHeader
      pathname={pathname}
      client:load
      transition:persist="site-header"
    />
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    {googleAnalyticsTag && <GoogleAnalytics id={googleAnalyticsTag} />}
  </body>
</html>
